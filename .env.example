# 构建/运行参数（复制为 .env 或直接修改默认值）

# 运行模式：dual=双实例吞吐×2（默认） | split=单实例双卡 CFG Split
COMPOSE_PROFILES=dual

# 与 ACR 构建产出的镜像一致（阿里云个人版实例 ininyumo/vedio_woekflow）
IMAGE_TAG=crpi-9pf9lin5vvnxq7uh.cn-hangzhou.personal.cr.aliyuncs.com/ininyumo/vedio_woekflow:v0.34.0-cu126-4090x2
COMFYUI_VERSION=v0.34.0
# dual 模式下实例 A 用 8188、实例 B 用 8189；split 模式只有 8188

# 模型下载与容器内 HuggingFace 端点（海外网络改为 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com

# 追加启动参数。4090 可开 SageAttention 提速 10-30%:
#   COMFY_EXTRA_ARGS=--use-sage-attention
# 显存吃紧时（一般用不到）: --lowvram
COMFY_EXTRA_ARGS=
