# 构建/运行参数（复制为 .env 或直接修改默认值）

# 镜像 tag：构建在 ACR 控制台进行（本机不构建），服务器只 docker compose pull
IMAGE_TAG=crpi-9pf9lin5vvnxq7uh.cn-hangzhou.personal.cr.aliyuncs.com/ininyumo/vedio_woekflow:v0.34.5-cu130-torch2.12.1
COMFYUI_VERSION=v0.34.5

# 模型下载与容器内 HuggingFace 端点（海外网络改为 https://huggingface.co）
HF_ENDPOINT=https://hf-mirror.com

# 追加启动参数。SageAttention 在 5090 + torch2.9 组合上需首跑验证：
#   COMFY_EXTRA_ARGS=--use-sage-attention
# 启动日志出现 "Using sage attention" 才算生效；报错就把这行清空
# 显存吃紧时（32G 一般用不到）: --lowvram
COMFY_EXTRA_ARGS=
