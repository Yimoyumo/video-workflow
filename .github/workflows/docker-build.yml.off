name: docker-build-acr

# 推 main / 打 tag / 手动触发 → 构建 → CPU 冒烟 → 推送阿里云 ACR（PR 只构建验证不推送）
# 前置（一次性）:
#   1. 开通阿里云容器镜像服务个人版（免费，需实名认证），选择离 GPU 服务器最近的区域
#   2. 控制台创建命名空间 + 仓库（个人版不会在首次 push 时自动建仓库），仓库可设私有
#   3. 控制台「访问凭证」设置固定密码
#   4. GitHub 仓库 Secrets 配置: ACR_USERNAME / ACR_PASSWORD
on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
  workflow_dispatch:

env:
  # 阿里云个人版实例（crpi 新版域名）——重新启用本 workflow 时记得在 Secrets 配
  # ACR_USERNAME / ACR_PASSWORD（访问凭证固定密码）
  REGISTRY: crpi-9pf9lin5vvnxq7uh.cn-hangzhou.personal.cr.aliyuncs.com
  NAMESPACE: ininyumo
  REPO: vedio_woekflow

concurrency:
  group: docker-build-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # 免费 runner 磁盘约 14GB，清掉预装工具链腾出 ~25GB（镜像解压态 ~10GB）
      - name: Free disk space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
                      /opt/hostedtoolcache/CodeQL /usr/local/.ghcup || true
          docker image prune -af || true
          df -h /

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Login to Aliyun ACR
        if: github.event_name != 'pull_request'
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.ACR_USERNAME }}
          password: ${{ secrets.ACR_PASSWORD }}

      - name: Docker meta
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.NAMESPACE }}/${{ env.REPO }}
          tags: |
            type=ref,event=branch
            type=ref,event=tag
            type=sha,format=short

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          push: ${{ github.event_name != 'pull_request' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          # gha 层缓存：首次约 15-20 分钟，命中缓存后约 5 分钟
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # 无 GPU 也能验证：ComfyUI 纯 CPU 可启动，/system_stats 返回 200 即健康
      - name: CPU smoke test
        run: |
          IMAGE="${REGISTRY}/${NAMESPACE}/${REPO}:${{ steps.meta.outputs.version }}"
          echo "smoke test: $IMAGE"
          docker run -d --name smoke -e PORT=8188 "$IMAGE"
          for i in $(seq 1 60); do
            if curl -sf http://127.0.0.1:8188/system_stats >/dev/null; then
              echo "ComfyUI startup OK"
              docker logs smoke 2>&1 | tail -5
              docker rm -f smoke
              exit 0
            fi
            sleep 5
          done
          echo "smoke test FAILED"
          docker logs smoke 2>&1 | tail -50
          docker rm -f smoke
          exit 1
